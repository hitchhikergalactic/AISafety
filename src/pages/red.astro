---
// src/pages/red.astro
import Layout from '../layouts/Layout.astro';
import Red from '../components/pages/Red.tsx';
import { redContent } from '../data/red';

const c = redContent.es;
const alternates = { es: redContent.es.canonical, en: redContent.en.canonical };
---

<Layout lang="es" title={c.seoTitle} description={c.description} canonicalUrl={c.canonical} alternates={alternates}>
  <Red lang="es" client:load />
</Layout>

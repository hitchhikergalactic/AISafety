---
// src/pages/aviso-legal.astro
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DocumentPage from '../components/pages/DocumentPage.tsx';
import { avisoLegalContent } from '../data/legal';

const entry = await getEntry('avisoLegal', 'es');
const { Content } = await render(entry!);
const c = avisoLegalContent.es;
---

<Layout lang="es" title={c.seoTitle} description={c.subtitle} ogTitle={c.seoTitle} ogDescription={c.subtitle}>
  <DocumentPage lang="es" header={c} subject="Nuevo suscriptor desde Aviso legal" client:load>
    <Content />
  </DocumentPage>
</Layout>

---
// src/pages/en/biblioteca-papers/index.astro
import Layout from '../../../layouts/Layout.astro';
import BibliotecaHub from '../../../components/pages/BibliotecaHub.tsx';
import { getCollection } from 'astro:content';

const allPapers = await getCollection('papers');
const papers = allPapers.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<Layout lang="en" title="Papers Library | AI safety España" description="Explore AI safety scientific papers translated and summarized in Spanish by the AI Safety España community.">
  <BibliotecaHub lang="en" papers={papers} client:load />
</Layout>

---
// src/pages/en/theory-of-change.astro
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DocumentPage from '../../components/pages/DocumentPage.tsx';
import { teoriaDelCambioContent } from '../../data/teoria-del-cambio';

const entry = await getEntry('teoriaDelCambio', 'en');
const c = teoriaDelCambioContent.en;
// Una sola fuente: el título, la descripción y el canonical del Markdown deben coincidir con los datos de la cabecera.
if (entry!.data.title !== c.title || entry!.data.description !== c.subtitle || entry!.data.canonical !== c.canonical) {
  throw new Error('teoria-del-cambio/en.md y src/data/teoria-del-cambio.ts no coinciden en título, descripción o canonical');
}
const { Content } = await render(entry!);
const alternates = { es: teoriaDelCambioContent.es.canonical, en: teoriaDelCambioContent.en.canonical };
---

<Layout
  lang="en"
  title={c.seoTitle}
  description={c.subtitle}
  ogTitle={c.seoTitle}
  ogDescription={c.subtitle}
  canonicalUrl={c.canonical}
  alternates={alternates}
>
  <DocumentPage lang="en" header={c} subject="New subscriber from Theory of Change" client:load>
    <Content />
  </DocumentPage>
</Layout>

---
// src/pages/biblioteca-papers/index.astro
import Layout from '../../layouts/Layout.astro';
import BibliotecaHub from '../../components/pages/BibliotecaHub.tsx';
import { getCollection } from 'astro:content';

const allPapers = await getCollection('papers');
const papers = allPapers.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<Layout lang="es" title="Biblioteca de Papers | AI safety España" description="Explora papers científicos sobre seguridad de la IA traducidos y comentados por la comunidad de AI Safety España.">
  <BibliotecaHub lang="es" papers={papers} client:load />
</Layout>

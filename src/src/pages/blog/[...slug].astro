---
// src/pages/blog/[...slug].astro
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (d: Date) =>
  d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const sectionLabel = { personal: 'Reflexión', tecnico: 'iaS técnico' };
---

<Layout lang="es" title={`${post.data.title} | Blog iaS`} description={post.data.description}>
  <article class="max-w-[720px] mx-auto px-4 md:px-12 pt-32 md:pt-40 pb-24">
    <span class="inline-block text-xs font-sans font-bold uppercase tracking-[0.15em] text-principal mb-3">
      {sectionLabel[post.data.section]}
    </span>
    <h1 class="font-serif text-3xl md:text-5xl font-bold text-secundarios-dark dark:text-secundarios-light mb-4">
      {post.data.title}
    </h1>
    <time class="text-sm font-sans opacity-60 block mb-10">{formatDate(post.data.pubDate)}</time>

    <div class="prose-blog">
      <Content />
    </div>

    <a
      href="/blog"
      class="inline-block mt-16 text-sm font-sans font-bold uppercase tracking-[0.15em] text-principal hover:opacity-70 transition-opacity"
    >
      ← Volver al blog
    </a>
  </article>
</Layout>

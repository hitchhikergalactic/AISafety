---
// src/pages/blog/index.astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (d: Date) =>
  d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const sectionLabel = { personal: 'Reflexión', tecnico: 'iaS técnico' };
---

<Layout
  lang="es"
  title="Blog | AI safety España"
  description="Reflexiones y contenido técnico de iaS sobre AI safety en español."
>
  <main class="max-w-[900px] mx-auto px-4 md:px-12 pt-32 md:pt-40 pb-24">
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-secundarios-dark dark:text-secundarios-light mb-4">
      Blog
    </h1>
    <p class="font-serif text-lg opacity-80 mb-12 max-w-[600px]">
      Reflexión personal y contenido técnico sobre AI safety, en español.
    </p>

    <div class="flex flex-col gap-8">
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="block p-6 md:p-8 rounded-anthro border border-secundarios-dark/10 shadow-anthro-subtle hover:shadow-anthro-card transition-shadow duration-300"
        >
          <span class="inline-block text-xs font-sans font-bold uppercase tracking-[0.15em] text-principal mb-3">
            {sectionLabel[post.data.section]}
          </span>
          <h2 class="font-serif text-2xl md:text-3xl font-bold text-secundarios-dark dark:text-secundarios-light mb-2">
            {post.data.title}
          </h2>
          <p class="font-serif opacity-80 mb-3">{post.data.description}</p>
          <time class="text-sm font-sans opacity-60">{formatDate(post.data.pubDate)}</time>
        </a>
      ))}
    </div>

    {posts.length === 0 && (
      <p class="font-serif opacity-70">Todavía no hay artículos publicados.</p>
    )}
  </main>
</Layout>
